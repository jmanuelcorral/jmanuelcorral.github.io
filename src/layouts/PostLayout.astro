---
// PostLayout: the reading layout for a single article. No post/article
// screen exists in the export (only home/listing was designed), so this is
// an *extrapolation*: built strictly from patterns already established
// elsewhere in the design (surface/line/mono tokens, `.eyebrow`-style kind
// label, `.t` tag chips, `.btn-ghost` back link, code-block styling in
// global.css) rather than inventing new visual language. Disclosed in the
// final report as a non-reference surface.
import BaseLayout from './BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import TagList from '../components/TagList.astro';
import { t, localePath, type Locale } from '../lib/i18n';

interface Translation {
  locale: Locale;
  path: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  translations?: Translation[];
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingMinutes?: number;
}

const {
  locale,
  title,
  description,
  path,
  translations = [],
  pubDate,
  updatedDate,
  tags,
  readingMinutes,
} = Astro.props;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path={path}
  translations={translations}
  ogType="article"
  structuredData={{
    kind: 'article',
    headline: title,
    description,
    datePublished: pubDate,
    dateModified: updatedDate,
  }}
>
  <article class="article sec-pad">
    <a class="btn btn-ghost article__back" href={localePath(locale)}>← {t(locale, 'backToBlog')}</a>
    <header class="article__header">
      <h1>{title}</h1>
      <ArticleMeta locale={locale} pubDate={pubDate} updatedDate={updatedDate} readingMinutes={readingMinutes} />
      <TagList tags={tags} label={t(locale, 'tags')} />
    </header>
    <div class="article__body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }

  .article__back {
    margin-bottom: 32px;
  }

  .article__header {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .article__header h1 {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--fg);
    margin-bottom: 16px;
  }

  .article__body {
    color: var(--fg);
    line-height: 1.75;
    font-size: 16px;
  }

  .article__body :global(h2) {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .article__body :global(h3) {
    font-size: 18px;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 10px;
  }

  .article__body :global(p) {
    margin: 0 0 18px;
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
  }

  .article__body :global(li) {
    margin-bottom: 6px;
  }

  .article__body :global(pre) {
    margin: 20px 0;
  }

  .article__body :global(table) {
    width: 100%;
    margin: 24px 0;
    border: 1px solid var(--line-2);
    border-spacing: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
    font-size: 14px;
    line-height: 1.6;
  }

  .article__body :global(th),
  .article__body :global(td) {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .article__body :global(th) {
    background: var(--surface-2);
    color: var(--accent);
    font-weight: 700;
    border-bottom: 1px solid var(--line-2);
  }

  .article__body :global(th + th),
  .article__body :global(td + td) {
    border-left: 1px solid var(--line);
  }

  .article__body :global(tbody tr + tr td) {
    border-top: 1px solid var(--line);
  }

  .article__body :global(tbody tr:nth-child(even)) {
    background: color-mix(in srgb, var(--surface-2) 45%, var(--surface));
  }

  @media (max-width: 600px) {
    .article__body :global(table) {
      display: block;
      overflow-x: auto;
    }

    .article__body :global(th),
    .article__body :global(td) {
      min-width: 140px;
      padding: 10px 12px;
    }
  }

  .article__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article__body :global(blockquote) {
    margin: 20px 0;
    padding: 4px 18px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }

  .article__body :global(.sketch-flow) {
    margin: 24px 0;
    padding: 28px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .article__body :global(.sketch-flow ol) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article__body :global(.sketch-flow li) {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    min-height: 112px;
    margin: 0;
    padding: 14px 8px;
    border: 2px solid var(--accent);
    border-radius: 9px 15px 8px 13px / 14px 8px 13px 7px;
    box-shadow: 3px 3px 0 var(--accent-soft);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }

  .article__body :global(.sketch-flow li:nth-child(even)) {
    border-radius: 15px 8px 13px 9px / 8px 14px 7px 13px;
    border-color: var(--indigo);
    box-shadow: 3px 3px 0 var(--indigo-soft);
  }

  .article__body :global(.sketch-flow li + li::before) {
    content: '→';
    position: absolute;
    left: -25px;
    top: 50%;
    width: 24px;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 22px;
  }

  .article__body :global(.sketch-flow span) {
    color: var(--muted);
    font-size: 11px;
  }

  .article__body :global(.sketch-flow figcaption) {
    margin-top: 20px;
    color: var(--muted);
    text-align: center;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .article__body :global(.sketch-flow ol) {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .article__body :global(.sketch-flow li) {
      min-height: 80px;
    }

    .article__body :global(.sketch-flow li + li::before) {
      content: '↓';
      left: 50%;
      top: -32px;
      transform: translateX(-50%);
    }
  }

  .article__body :global(img) {
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
  }
</style>
