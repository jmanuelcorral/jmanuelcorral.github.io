---
import { getAllPosts } from '../../../lib/content';
import { getPostAlternates } from '../../../lib/seo';
import PostView from '../../../components/PostView.astro';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  return allPosts
    .filter((post) => post.data.lang === 'en')
    .map((post) => ({
      params: { slug: post.data.slug },
      props: {
        post,
        translations: getPostAlternates(allPosts, post.data.translationKey),
      },
    }));
}

const { post, translations } = Astro.props;
---

<PostView locale="en" post={post} translations={translations} />
