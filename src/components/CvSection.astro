---
// CV section — ported verbatim from `newdesign/index.html` (#cv:
// `.cv-wrap`, `.cv-online`, `.cv-links`, `.dl`). Link targets point to the
// static passthrough files copied into `public/` (see final report for the
// scope decision on cv.html/resume-*.html/PDFs).
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = HOME_COPY[locale];
---

<section id="cv" class="sec-pad">
  <div class="sec-head">
    <div>
      <div class="eyebrow">{copy.cv.eyebrow}</div>
      <div class="sec-title">{copy.cv.title}</div>
      <p class="sec-sub">{copy.cv.sub}</p>
    </div>
  </div>

  <div class="cv-wrap">
    <div class="cv-online">
      <h3>{copy.cv.onlineTitle}</h3>
      <p>{copy.cv.onlineText}</p>
      <div class="hero-actions" style="margin-top:20px;">
        <a class="btn btn-primary" href="/resume-short.html">{copy.cv.short}</a>
        <a class="btn btn-ghost" href="/resume-extended.html">{copy.cv.extended}</a>
      </div>
    </div>

    <div class="cv-links">
      <a class="dl" href="/mtsfs81s-Jose_Corral_CV_SHORT_2026.pdf" download>
        <span class="ic"
          ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"></path></svg
          ></span
        >
        <span class="txt"><b>{copy.cv.dlShortT}</b><span>{copy.cv.dlShortS}</span></span>
        <span class="arr">↓</span>
      </a>
      <a class="dl" href="/mtsfs824-Jose_Corral_CV_Extended_2026.pdf" download>
        <span class="ic"
          ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"></path></svg
          ></span
        >
        <span class="txt"><b>{copy.cv.dlExtT}</b><span>{copy.cv.dlExtS}</span></span>
        <span class="arr">↓</span>
      </a>
      <a class="dl" href="/cv.html">
        <span class="ic"
          ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            ><path d="M4 6h16M4 12h16M4 18h10"></path></svg
          ></span
        >
        <span class="txt"><b>{copy.cv.idxT}</b><span>{copy.cv.idxS}</span></span>
        <span class="arr">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cv-wrap {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 820px) {
    .cv-wrap {
      grid-template-columns: 1fr;
    }
  }
  .cv-online {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 13px;
    padding: 26px;
    display: flex;
    flex-direction: column;
  }
  .cv-online h3 {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 8px;
  }
  .cv-online p {
    font-size: 13px;
    color: var(--muted);
    flex: 1;
  }
  .cv-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .dl {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 15px 18px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .dl:hover {
    border-color: var(--accent);
  }
  .dl .ic {
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 9px;
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    display: grid;
    place-items: center;
    color: var(--accent);
  }
  .dl .ic svg {
    width: 18px;
    height: 18px;
  }
  .dl .txt {
    flex: 1;
  }
  .dl .txt b {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--fg);
  }
  .dl .txt span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--faint);
  }
  .dl .arr {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    font-weight: 700;
  }
</style>
