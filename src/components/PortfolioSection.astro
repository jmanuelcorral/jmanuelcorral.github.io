---
// Portfolio section (repo cards + starred strip) — ported verbatim from
// `newdesign/index.html` (#portfolio: `.card.flag`, `.card.maint`,
// `.star-strip`). Repo names/links/tags/star-counts are the design's own
// real data and are reproduced as-is; only the localized description text
// comes from `homeCopy.ts`.
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = HOME_COPY[locale];

const starred = [
  { href: 'https://github.com/bradygaster/squad', name: 'bradygaster/squad', desc: 'AI agent teams for any project', stars: '3.2k' },
  { href: 'https://github.com/microsoft/apm', name: 'microsoft/apm', desc: 'Agent Package Manager', stars: '3.8k' },
  { href: 'https://github.com/OpenBMB/ChatDev', name: 'OpenBMB/ChatDev', desc: 'LLM-powered multi-agent collaboration', stars: '34k' },
  { href: 'https://github.com/Stevenic/vectra', name: 'Stevenic/vectra', desc: 'Base de datos vectorial local para Node.js', stars: '633' },
  { href: 'https://github.com/magdalenakuhn17/awesome-cheap-llms', name: 'awesome-cheap-llms', desc: 'Reducción de coste en sistemas LLM', stars: '88' },
  { href: 'https://github.com/Azure-Samples/agent-openai-java-banking-assistant', name: 'agent-openai-java-banking', desc: 'Asistente bancario multi-agente en Java', stars: '163' },
  { href: 'https://github.com/Azure/aoai-apim', name: 'Azure/aoai-apim', desc: 'Escalar Azure OpenAI con APIM, PTUs y TPMs', stars: '116' },
  { href: 'https://github.com/jrubiosainz/desktop-assistant', name: 'desktop-assistant', desc: 'Control de Windows con IA (Copilot SDK)', stars: '23' },
  { href: 'https://github.com/jmanuelcorral/squadcenter', name: 'jmanuelcorral/squadcenter', desc: 'Uso y monitorización de múltiples proyectos squad', stars: '21' },
];
---

<section id="portfolio" class="sec-pad">
  <div class="sec-head">
    <div>
      <div class="eyebrow">{copy.port.eyebrow}</div>
      <div class="sec-title">{copy.port.title}</div>
      <p class="sec-sub">{copy.port.sub}</p>
    </div>
    <a class="btn btn-ghost" href="https://github.com/jmanuelcorral?tab=repositories" target="_blank" rel="noopener"
      >{copy.port.allRepos}</a
    >
  </div>

  <div class="grid g-2">
    <article class="card flag">
      <span class="badge">{copy.flag.badge}</span>
      <div class="repo-top">
        <span class="repo-name"
          ><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          ><a class="repo-link" href="https://github.com/jmanuelcorral/openteam" target="_blank" rel="noopener"
            >openteam</a
          ></span
        >
        <span class="lang st-exp">{copy.flag.lang}</span>
      </div>
      <p class="desc">{copy.flag.desc}</p>
      <div class="repo-tags">
        <span class="t">agents</span><span class="t">orchestration</span><span class="t">routing</span><span
          class="t">telemetry</span
        >
      </div>
      <div class="repo-foot">
        <a href="https://github.com/jmanuelcorral/openteam" target="_blank" rel="noopener">{copy.foot.code}</a>
        <a href="https://github.com/jmanuelcorral/openteam#readme" target="_blank" rel="noopener">{copy.foot.docs}</a>
      </div>
    </article>

    <article class="card maint">
      <span class="badge-mini bm-maint">Maintainer</span>
      <div class="repo-top">
        <span class="repo-name"
          ><a class="repo-link" href="https://github.com/Veta-agentic/veta-agents" target="_blank" rel="noopener"
            >veta-agents</a
          ></span
        >
        <span class="lang st-exp">Python</span>
      </div>
      <p class="desc">{copy.veta.desc}</p>
      <div class="repo-tags">
        <span class="t">agents</span><span class="t">python</span><span class="t">framework</span>
      </div>
      <div class="repo-foot">
        <a href="https://github.com/Veta-agentic/veta-agents" target="_blank" rel="noopener">{copy.foot.code}</a>
        <a href="https://github.com/Veta-agentic/veta-agents#readme" target="_blank" rel="noopener"
          >{copy.foot.docs}</a
        >
      </div>
    </article>

    <article class="card maint">
      <span class="badge-mini bm-maint">Maintainer · Azure</span>
      <div class="repo-top">
        <span class="repo-name"
          ><a class="repo-link" href="https://github.com/Azure/CCOInsights" target="_blank" rel="noopener"
            >CCOInsights</a
          ></span
        >
        <span class="lang st-maint">Power BI</span>
      </div>
      <p class="desc">{copy.cco.desc}</p>
      <div class="repo-tags">
        <span class="t">azure</span><span class="t">finops</span><span class="t">governance</span>
      </div>
      <div class="repo-foot">
        <a href="https://github.com/Azure/CCOInsights" target="_blank" rel="noopener">{copy.foot.code}</a>
        <span class="stars"
          ><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
            ><path
              d="M8 .25l2.06 4.18 4.61.67-3.34 3.25.79 4.6L8 10.98l-4.12 2.17.79-4.6L1.33 5.1l4.61-.67z"
            ></path></svg
          >757</span
        >
      </div>
    </article>
  </div>

  <div class="sec-head" style="margin-top:52px;">
    <div>
      <div class="eyebrow ey-star">{copy.star.eyebrow}</div>
      <div class="sec-title" style="font-size:20px;">{copy.star.title}</div>
      <p class="sec-sub">{copy.star.sub}</p>
    </div>
    <a class="btn btn-ghost" href="https://github.com/jmanuelcorral?tab=stars" target="_blank" rel="noopener"
      >{copy.star.all}</a
    >
  </div>

  <div class="star-strip">
    {
      starred.map((item) => (
        <a class="star-item" href={item.href} target="_blank" rel="noopener">
          <div class="si-body">
            <div class="si-name">{item.name}</div>
            <div class="si-desc">{item.desc}</div>
          </div>
          <span class="si-stars">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 .25l2.06 4.18 4.61.67-3.34 3.25.79 4.6L8 10.98l-4.12 2.17.79-4.6L1.33 5.1l4.61-.67z" />
            </svg>
            {item.stars}
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 13px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      transform 0.15s,
      box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.22);
  }
  :global(html[data-theme='light']) .card:hover {
    box-shadow: 0 14px 36px rgba(15, 109, 99, 0.1);
  }
  .repo-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .repo-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .repo-link {
    color: inherit;
    text-decoration: none;
  }
  .repo-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .flag .repo-link:hover {
    color: var(--copper);
  }
  .repo-name svg {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--muted);
  }
  .lang {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--faint);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lang::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .card p.desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
    flex: 1;
  }
  .repo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .t {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 3px 7px;
  }
  .repo-foot {
    display: flex;
    gap: 16px;
    margin-top: 15px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .repo-foot a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .repo-foot a:hover {
    text-decoration: underline;
  }

  .flag {
    grid-column: span 2;
    background:
      linear-gradient(135deg, var(--copper-soft), transparent 62%),
      var(--surface);
    border-color: color-mix(in srgb, var(--copper) 34%, var(--line-2));
  }
  .flag:hover {
    border-color: var(--copper) !important;
  }
  @media (max-width: 600px) {
    .flag {
      grid-column: span 1;
    }
  }
  .flag .badge {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--copper);
    background: var(--copper-soft);
    border: 1px solid color-mix(in srgb, var(--copper) 34%, transparent);
    border-radius: 5px;
    padding: 3px 8px;
    align-self: flex-start;
    margin-bottom: 14px;
  }
  .flag .repo-name {
    font-size: 18px;
  }
  .flag .repo-name svg {
    color: var(--copper);
  }
  .flag p.desc {
    font-size: 14px;
  }
  .flag .repo-foot a {
    color: var(--copper);
  }

  .lang.st-stable::before {
    background: var(--ok);
  }
  .lang.st-exp::before {
    background: var(--warn);
  }
  .lang.st-maint::before {
    background: var(--copper);
  }
  .lang.st-arch::before {
    background: var(--faint);
  }

  .card.maint {
    border-color: color-mix(in srgb, var(--copper) 22%, var(--line));
  }
  .badge-mini {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 5px;
    align-self: flex-start;
    margin-bottom: 12px;
  }
  .badge-mini.bm-maint {
    color: var(--copper);
    background: var(--copper-soft);
    border: 1px solid color-mix(in srgb, var(--copper) 30%, transparent);
  }
  .badge-mini.bm-star {
    color: var(--warn);
    background: color-mix(in srgb, var(--warn) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--warn) 28%, transparent);
  }
  .stars {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--faint);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .stars svg {
    width: 12px;
    height: 12px;
    color: var(--warn);
  }

  .star-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 4px;
  }
  @media (max-width: 820px) {
    .star-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .star-strip {
      grid-template-columns: 1fr;
    }
  }
  .star-item {
    display: flex;
    align-items: center;
    gap: 11px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .star-item:hover {
    border-color: var(--warn);
    transform: translateY(-2px);
  }
  .star-item .si-body {
    flex: 1;
    min-width: 0;
  }
  .star-item .si-name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .star-item .si-desc {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }
  .star-item .si-stars {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--faint);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
  }
  .star-item .si-stars svg {
    width: 11px;
    height: 11px;
    color: var(--warn);
  }
</style>
