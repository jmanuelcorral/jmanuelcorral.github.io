---
// Skip link — accessibility utility with no equivalent in the design
// export (the export is a single static page, not a multi-route site with
// distinct <main> regions). Styled via the shared `.skip-link` class in
// global.css, built from the export's own accent/radius tokens rather than
// a separate palette.
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  locale: Locale;
  targetId?: string;
}

const { locale, targetId = 'main-content' } = Astro.props;
---

<a class="skip-link" href={`#${targetId}`}>{t(locale, 'skipToContent')}</a>
