---
// Shared rendering for a single post, used by both
// src/pages/es/blog/[slug].astro and src/pages/en/blog/[slug].astro.
import { render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { blogPostPath, type Locale } from '../lib/i18n';
import { estimateReadingMinutes, type BlogPost } from '../lib/content';
import type { AlternateLink } from '../lib/seo';

interface Props {
  locale: Locale;
  post: BlogPost;
  /** Hreflang alternates resolved in `getStaticPaths` via
   * `getPostAlternates`, so this component never needs the whole post
   * collection just to look one translation up. */
  translations: AlternateLink[];
}

const { locale, post, translations } = Astro.props;
const { Content } = await render(post);
const readingMinutes = estimateReadingMinutes(post.body ?? '');
---

<PostLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  path={blogPostPath(locale, post.data.slug)}
  translations={translations}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  readingMinutes={readingMinutes}
>
  <Content />
</PostLayout>
