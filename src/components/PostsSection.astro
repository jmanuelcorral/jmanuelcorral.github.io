---
// Posts section — ported visual pattern from `newdesign/index.html`
// (#posts: `.filters`, `.fbtn`, `.grid.g-3`, `.post`). The design ships a
// fixed "All / Cloud / DevOps" row and five hardcoded cards; here the cards
// render the real content collection and the filter row is derived from the
// categories those posts actually declare, so a button is never offered for
// a filter that would show nothing.
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';
import { getPostsByLocale, formatShortDate } from '../lib/content';
import { blogPostPath, localePath, t } from '../lib/i18n';
import { postCategoryFilters } from '../lib/postTaxonomy';

interface Props {
  locale: Locale;
  fullListing?: boolean;
}
const { locale, fullListing = false } = Astro.props;
const copy = HOME_COPY[locale];
const Heading = fullListing ? 'h1' : 'div';
const posts = (await getPostsByLocale(locale))
  .filter((post) => !post.data.tags.includes('experiment'))
  .slice(0, fullListing ? undefined : 3);
const filters = postCategoryFilters(
  posts.map((post) => post.data.category),
  locale,
);
---

<section id="posts" class="sec-pad">
  <div class="sec-head">
    <div>
      <div class="eyebrow ey-indigo">{copy.posts.eyebrow}</div>
      <Heading class="sec-title">{copy.posts.title}</Heading>
      <p class="sec-sub">{copy.posts.sub}</p>
    </div>
    {
      posts.length > 0 && (
        <div class="posts-actions">
          <div class="filters" id="post-filters" role="group" aria-label={copy.posts.eyebrow}>
            <button type="button" class="fbtn on" data-f="all" aria-pressed="true" aria-controls="post-grid">
              {copy.posts.fAll}
            </button>
            {filters.map((filter) => (
              <button
                type="button"
                class="fbtn"
                data-f={filter.value}
                aria-pressed="false"
                aria-controls="post-grid"
              >
                {filter.label}
              </button>
            ))}
          </div>
          <a class="btn btn-ghost" href={fullListing ? `${localePath(locale)}#posts` : localePath(locale, 'blog/')}>
            {fullListing ? `← ${t(locale, 'navHome')}` : copy.posts.all}
          </a>
        </div>
      )
    }
  </div>

  {
    posts.length === 0 ? (
      <p class="sec-sub">{t(locale, 'noPosts')}</p>
    ) : (
      <div class="grid g-3" id="post-grid">
        {posts.map((post) => (
          <a class="post" href={blogPostPath(locale, post.data.slug)} data-cat={post.data.category}>
            <div class="kind">{post.data.kind}</div>
            <h4>{post.data.title}</h4>
            <p>{post.data.description}</p>
            <div class="date">{formatShortDate(post.data.pubDate, locale)}</div>
          </a>
        ))}
      </div>
    )
  }
</section>

<script>
  // Post filters — same behavior as the lab filters: the clicked button
  // becomes the active one (class and aria-pressed together) and cards that
  // don't match its category are hidden.
  const filterWrap = document.getElementById('post-filters');
  const postGrid = document.getElementById('post-grid');

  if (filterWrap && postGrid) {
    filterWrap.addEventListener('click', (event) => {
      const target = event.target;
      const button = target instanceof Element ? target.closest('button[data-f]') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      const category = button.dataset.f;

      filterWrap.querySelectorAll<HTMLButtonElement>('.fbtn').forEach((filter) => {
        const active = filter.dataset.f === category;
        filter.classList.toggle('on', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      postGrid.querySelectorAll<HTMLElement>('.post').forEach((card) => {
        card.classList.toggle('hidden', category !== 'all' && card.dataset.cat !== category);
      });
    });
  }
</script>

<style>
  .filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .fbtn {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 6px 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .fbtn:hover {
    border-color: var(--line-2);
    color: var(--fg);
  }
  .fbtn.on {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
    color: var(--accent);
  }
  .posts-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  #posts :global(.post .kind) {
    color: var(--indigo);
  }
</style>
