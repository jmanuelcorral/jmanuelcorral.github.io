---
// Posts section — ported visual pattern from `newdesign/index.html`
// (#posts: `.filters`, `.fbtn`, `.grid.g-3`, `.post`). The design ships a
// fixed "All / Cloud / DevOps" row and five hardcoded cards; here the cards
// render the real content collection and the filter row is derived from the
// categories those posts actually declare, so a button is never offered for
// a filter that would show nothing.
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';
import { getPostsByLocale, formatShortDate } from '../lib/content';
import { blogPostPath, localePath, t } from '../lib/i18n';
import { postCategoryFilters } from '../lib/postTaxonomy';

interface Props {
  locale: Locale;
  fullListing?: boolean;
}
const { locale, fullListing = false } = Astro.props;
const copy = HOME_COPY[locale];
const Heading = fullListing ? 'h1' : 'div';
const posts = (await getPostsByLocale(locale))
  .filter((post) => !post.data.tags.includes('experiment'))
  .slice(0, fullListing ? undefined : 3);
const filters = postCategoryFilters(
  posts.map((post) => post.data.category),
  locale,
);
---

<section id="posts" class="sec-pad">
  <div class="sec-head">
    <div>
      <div class="eyebrow ey-indigo">{copy.posts.eyebrow}</div>
      <Heading class="sec-title">{copy.posts.title}</Heading>
      <p class="sec-sub">{copy.posts.sub}</p>
    </div>
    {
      posts.length > 0 && (
        <div class="posts-actions">
          <div class="filters" id="post-filters" role="group" aria-label={copy.posts.eyebrow}>
            <button type="button" class="fbtn on" data-f="all" aria-pressed="true" aria-controls="post-grid">
              {copy.posts.fAll}
            </button>
            {filters.map((filter) => (
              <button
                type="button"
                class="fbtn"
                data-f={filter.value}
                aria-pressed="false"
                aria-controls="post-grid"
              >
                {filter.label}
              </button>
            ))}
          </div>
          <a class="btn btn-ghost" href={fullListing ? `${localePath(locale)}#posts` : localePath(locale, 'blog/')}>
            {fullListing ? `← ${t(locale, 'navHome')}` : copy.posts.all}
          </a>
        </div>
      )
    }
  </div>

  {
    posts.length === 0 ? (
      <p class="sec-sub">{t(locale, 'noPosts')}</p>
    ) : (
      <div class="grid g-3" id="post-grid">
        {posts.map((post) => (
          <a class="post" href={blogPostPath(locale, post.data.slug)} data-cat={post.data.category}>
            <div class="kind">{post.data.kind}</div>
            <h4>{post.data.title}</h4>
            <p>{post.data.description}</p>
            <div class="date">{formatShortDate(post.data.pubDate, locale)}</div>
          </a>
        ))}
      </div>
    )
  }
</section>

<script>
  import { initFilterSection } from '../lib/filterSection';

  initFilterSection('post-filters', 'post-grid');
</script>

<style>
  #posts :global(.post .kind) {
    color: var(--indigo);
  }
</style>
