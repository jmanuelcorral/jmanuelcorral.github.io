---
// Labs section — ported verbatim from `newdesign/index.html` (#labs:
// `.post.stub` dashed placeholder cards). No real experiment data exists
// yet, so per the design's own placeholder pattern these stay literal
// placeholders (not replaced with invented "real" content).
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = HOME_COPY[locale];
---

<section id="labs" class="sec-pad">
  <div class="sec-head">
    <div>
      <div class="eyebrow ey-copper">{copy.labs.eyebrow}</div>
      <div class="sec-title">{copy.labs.title}</div>
      <p class="sec-sub">{copy.labs.sub}</p>
    </div>
  </div>

  <div class="grid g-3">
    <article class="post stub" data-cat="ia">
      <div class="kind">{copy.labs.lab1Kind}</div>
      <h4>{copy.labs.lab1Title}</h4>
      <div class="ph w70"></div>
      <div class="ph"></div>
      <div class="ph w45"></div>
      <div class="date">{copy.labs.pending}</div>
    </article>
    <article class="post stub" data-cat="ia">
      <div class="kind">{copy.labs.lab2Kind}</div>
      <h4>{copy.labs.lab2Title}</h4>
      <div class="ph"></div>
      <div class="ph w70"></div>
      <div class="ph w45"></div>
      <div class="date">{copy.labs.pending}</div>
    </article>
    <article class="post stub" data-cat="ia">
      <div class="kind">{copy.labs.lab3Kind}</div>
      <h4>{copy.labs.lab3Title}</h4>
      <div class="ph w70"></div>
      <div class="ph"></div>
      <div class="ph w45"></div>
      <div class="date">{copy.labs.pending}</div>
    </article>
  </div>
  <div class="seed-note">{copy.labs.seed}</div>
</section>

<style>
  #labs .post .kind {
    color: var(--copper);
  }
  #labs .fbtn.on {
    background: var(--copper-soft);
    border-color: color-mix(in srgb, var(--copper) 34%, transparent);
    color: var(--copper);
  }
  .post.stub {
    border-style: dashed;
    background: transparent;
  }
  .post.stub h4 {
    color: var(--muted);
  }
  .post.stub .ph {
    height: 9px;
    border-radius: 4px;
    background: var(--surface-2);
    margin-bottom: 8px;
  }
  .post.stub .ph.w70 {
    width: 70%;
  }
  .post.stub .ph.w45 {
    width: 45%;
  }
  .seed-note {
    font-size: 12px;
    color: var(--faint);
    margin-top: 20px;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .seed-note::before {
    content: '';
    width: 16px;
    height: 1px;
    background: var(--line-2);
  }
</style>
