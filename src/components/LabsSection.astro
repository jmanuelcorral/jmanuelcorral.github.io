---
// Labs section — preserves the three-card OpenDesign structure while linking
// the two published experiment guides from the canonical blog collection.
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';
import { getPostsByLocale, formatShortDate } from '../lib/content';
import { blogPostPath, localePath, t } from '../lib/i18n';
import { experimentCategoryFilters } from '../lib/postTaxonomy';

interface Props {
  locale: Locale;
  fullListing?: boolean;
}
const { locale, fullListing = false } = Astro.props;
const copy = HOME_COPY[locale];
const Heading = fullListing ? 'h1' : 'div';
const experiments = (await getPostsByLocale(locale))
  .filter((post) => post.data.tags.includes('experiment'))
  .slice(0, fullListing ? undefined : 3);
const filters = experimentCategoryFilters(
  experiments.map((post) => post.data.experimentCategory),
  locale,
);
---

<section id="labs" class="sec-pad">
  <div class="sec-head">
    <div>
      <div class="eyebrow ey-copper">{copy.labs.eyebrow}</div>
      <Heading class="sec-title">{copy.labs.title}</Heading>
      <p class="sec-sub">{copy.labs.sub}</p>
    </div>
    <div class="labs-actions" id="lab-filters">
      <div class="filters" role="group" aria-label={copy.labs.eyebrow}>
        <button type="button" class="fbtn on" data-f="all" aria-pressed="true" aria-controls="lab-grid">
          {copy.labs.fAll}
        </button>
        {filters.map((filter) => (
          <button
            type="button"
            class="fbtn"
            data-f={filter.value}
            aria-pressed="false"
            aria-controls="lab-grid"
          >
            {filter.label}
          </button>
        ))}
      </div>
      <a class="btn btn-ghost" href={fullListing ? `${localePath(locale)}#labs` : localePath(locale, 'experiments/')}>
        {fullListing ? `← ${t(locale, 'navHome')}` : copy.labs.all}
      </a>
    </div>
  </div>

  <div class="grid g-3" id="lab-grid">
    {
      experiments.map((post) => (
        <a class="post" href={blogPostPath(locale, post.data.slug)} data-cat={post.data.experimentCategory}>
          <div class="kind">{post.data.kind}</div>
          <h4>{post.data.title}</h4>
          <p>{post.data.description}</p>
          <div class="date">{formatShortDate(post.data.pubDate, locale)}</div>
        </a>
      ))
    }
  </div>
</section>

<script>
  const filterWrap = document.getElementById('lab-filters');
  const labGrid = document.getElementById('lab-grid');

  if (filterWrap && labGrid) {
    filterWrap.addEventListener('click', (event) => {
      const target = event.target;
      const button = target instanceof Element ? target.closest('button[data-f]') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      const category = button.dataset.f;

      filterWrap.querySelectorAll<HTMLButtonElement>('.fbtn').forEach((filter) => {
        const active = filter.dataset.f === category;
        filter.classList.toggle('on', active);
        filter.setAttribute('aria-pressed', String(active));
      });
      labGrid.querySelectorAll<HTMLElement>('.post').forEach((card) => {
        card.classList.toggle('hidden', category !== 'all' && card.dataset.cat !== category);
      });
    });
  }
</script>

<style>
  .filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .fbtn {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 6px 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .fbtn:hover {
    border-color: var(--line-2);
    color: var(--fg);
  }
  .labs-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  #labs .post .kind {
    color: var(--copper);
  }
  .fbtn.on {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 34%, transparent);
    color: var(--accent);
  }
  .labs-actions .btn {
    line-height: 1.5;
  }
  .post.stub {
    border-style: dashed;
    background: transparent;
  }
  .post.stub h4 {
    color: var(--muted);
  }
  .post.stub .ph {
    height: 9px;
    border-radius: 4px;
    background: var(--surface-2);
    margin-bottom: 8px;
  }
  .post.stub .ph.w70 {
    width: 70%;
  }
  .post.stub .ph.w45 {
    width: 45%;
  }
  .seed-note {
    font-size: 12px;
    color: var(--faint);
    margin-top: 20px;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .seed-note::before {
    content: '';
    width: 16px;
    height: 1px;
    background: var(--line-2);
  }
</style>
