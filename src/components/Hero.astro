---
// Hero + interactive terminal — ported verbatim from `newdesign/index.html`
// (`.hero`, `.hero-grid`, `.hero-meta`, `.hero-actions`, `.term`). The CLI
// simulator itself lives in `Terminal.astro`.
import type { Locale } from '../lib/i18n';
import { HOME_COPY } from '../lib/homeCopy';
import Terminal from './Terminal.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = HOME_COPY[locale];
---

<section class="hero">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">{copy.hero.eyebrow}</div>
      <h1 set:html={copy.hero.titleHtml} />
      <p class="hero-lead">{copy.hero.lead}</p>
      <div class="hero-meta">
        <span set:html={copy.hero.meta1Html} />
        <span>Azure · AKS · GitHub</span>
        <span>Agentic AI · RAG · MLOps</span>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#portfolio">{copy.hero.ctaPortfolio}</a>
        <a class="btn btn-ghost" href="#cv">{copy.hero.ctaCv}</a>
      </div>
    </div>
    <Terminal locale={locale} />
  </div>
</section>

<style>
  .hero {
    padding-top: 64px;
    padding-bottom: 8px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .hero :global(h1) {
    font-size: clamp(34px, 5.6vw, 58px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--fg);
  }
  .hero :global(h1 .hl) {
    color: var(--accent);
  }
  .hero-lead {
    font-size: 16px;
    color: var(--muted);
    margin-top: 20px;
    max-width: 52ch;
  }
  .hero-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .hero-meta :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .hero-meta :global(b) {
    color: var(--fg);
    font-weight: 600;
    font-family: var(--font-sans);
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
</style>
